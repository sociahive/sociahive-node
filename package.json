{
  "name": "@sociahive/sdk",
  "version": "0.2.0",
  "description": "Official Node.js SDK for the SociaHive API: post scheduling, DM and comment automations, and analytics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sociahive/sociahive-node.git"
  },
  "homepage": "https://docs.sociahive.com",
  "bugs": {
    "url": "https://github.com/sociahive/sociahive-node/issues"
  },
  "keywords": [
    "sociahive",
    "social-media",
    "instagram",
    "automation",
    "scheduler",
    "mcp"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript https://www.sociahive.com/api/v1/openapi.json -o src/generated.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "openapi-typescript": "^7.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
